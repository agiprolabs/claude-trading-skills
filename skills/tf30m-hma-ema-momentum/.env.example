# Copy to Railway's Variables tab (or a local .env for testing).
# Defaults below are the safe starting point: PAPER trading, 2 positions max
# portfolio-wide, 1 position max per symbol (always enforced, not configurable).

# --- Exchange / market ---
EXCHANGE_ID=okx
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT
MARGIN_MODE=cross
LEVERAGE=1

# --- Mode ---
PAPER=true
BALANCE=10000

# --- Risk (RiskManager) ---
MARGIN_FRACTION=0.05
MAX_OPEN_POSITIONS=2
MAX_DRAWDOWN_PCT=0.15

# --- Polling ---
POLL_SECONDS=20

# --- Live credentials (leave blank while PAPER=true) ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=

# --- Telegram alerts + commands (optional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
